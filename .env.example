# Required for all reasoning stages.
GROQ_API_KEY=replace_with_your_groq_api_key

# Optional: use a Groq model available to your account. The Streamlit sidebar
# lets each user choose between this value and the account-gated Llama option.
# Default: openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: used only when "Use local LLM for low-power tasks" is enabled.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
